		{
			"Name": "VRETLoggerMetaXR",
			"Type": "Runtime",
			"LoadingPhase": "Default",
			"PlatformAllowList": [
				"Win64",
				"Android"
			]
		}
	],
	"Plugins": [
		{
			"Name": "VRETLogger",
			"Enabled": true
		},
		{
			"Name": "OculusXR",
			"Enabled": true
		}
	]
